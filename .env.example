# The website always uses local Ollama. These settings are optional defaults.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:1.7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# PORT=3000

# The terminal CLI also supports this optional paid provider when explicitly set:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
